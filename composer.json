{
	"name": "igorpocta/data-mapper",
	"description": "Lightweight PHP library for mapping data to objects and back (e.g. JSON ↔ object).",
	"type": "library",
	"license": "MIT",
	"authors": [
		{
			"name": "Igor Počta",
			"email": "igorpocta@qadata.cz"
		}
	],
	"require": {
		"php": "^8.1"
	},
	"autoload": {
		"psr-4": {
			"Pocta\\DataMapper\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "phpunit --colors=always",
		"phpstan": "phpstan analyse --memory-limit=256M",
		"check": [
			"@phpstan",
			"@test"
		]
	},
	"scripts-descriptions": {
		"check": "Run PHPStan and the test suite (same checks as CI)"
	},
	"config": {
		"platform": {
			"php": "8.1.0"
		},
		"sort-packages": true
	},
	"suggest": {
		"psr/simple-cache": "To use any PSR-16 cache (Symfony, Laravel, ...) via Pocta\\DataMapper\\Cache\\Psr16Cache",
		"ext-redis": "To use RedisCache with phpredis",
		"predis/predis": "To use RedisCache with Predis"
	},
	"minimum-stability": "stable",
	"prefer-stable": true,
	"require-dev": {
		"phpstan/phpstan": "2.3.*",
		"phpunit/phpunit": "^10.5",
		"predis/predis": "^2.2",
		"psr/simple-cache": "^3.0"
	}
}
