parameters:
    level: 9
    # Analyse against the whole supported range, so results do not depend on the PHP version PHPStan runs on
    phpVersion:
        min: 80100
        max: 80599
    paths:
        - src
        - tests
    excludePaths:
        - tests/Fixtures
        # Uses PHP 8.4 asymmetric visibility fixture; runs only on PHP >= 8.4 (RequiresPhp)
        - tests/AsymmetricVisibilityTest.php
